rules_version = '2';
// Shared Firebase project (akxh-games).
// Who zzit? uses NO Firebase Auth — local UUID identity only.
// Deploy as the full ruleset (merge). Do not deploy whozzit-only rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Open lobby sync (party codes are short-lived). No request.auth.
    match /whozzit_lobbies/{lobbyId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // Optional presence / name docs keyed by local UUID.
    match /whozzit_users/{userId} {
      allow read, write: if true;
    }
    // Packs: client read OK; writes only via Admin SDK (/admin + seed).
    match /whozzit_words/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /whozzit_packs/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /spycy_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /spycy_lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /spycy_words/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /ishaare_users/{uid} { allow read, write: if false; }
    match /ishaare_decks/{id} { allow read, write: if false; }
    match /ishaare_words/{id} { allow read, write: if false; }

    match /users/{id} { allow read, write: if false; }
    match /decks/{id} { allow read, write: if false; }
    match /words/{id} { allow read, write: if false; }
    match /lobbies/{id} { allow read, write: if false; }
  }
}
